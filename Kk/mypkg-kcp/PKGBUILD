_realname=kcp
pkgbase=mypkg-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-mypkg-${_realname}")
pkgver=2.1.1
pkgrel=1
pkgdesc="⚡ KCP - A Fast and Reliable ARQ Protocol"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/skywind3000/kcp'
# https://repology.org/project/kcp-arq-protocol/versions
msys2_repository_url='https://github.com/skywind3000/kcp'
msys2_issue_tracker_url='https://github.com/skywind3000/kcp/issues'
license=('MIT')
depends=("${MINGW_PACKAGE_PREFIX}-cc-libs")
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
)

source=("${msys2_repository_url}/archive/${pkgver}/${pkgver}.tar.gz")
sha256sums=('54d3c80928d206529f67cba6f96f2c98007182b46e3112819b200d914f96e425')
b2sums=('331b080d73161b8ab3c1c5cf5e10f4b345d6fffedcb1ef92ffc13ec436987c8986bdbb6638b6d9124fb39fbfa2115b91263a5b283154ad19f04e5fe528bdc9e3')

build() {
  declare -a _cmake_opts=(
    -GNinja
    -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}"
    -DCMAKE_PREFIX_PATH="${MINGW_PREFIX}"
    -DCMAKE_MODULE_PATH="${MINGW_PREFIX}"/lib/cmake

    -S "${_realname}-${pkgver}"
  )

  if check_option "debug" "n"; then
    _cmake_opts+=("-DCMAKE_BUILD_TYPE=Release")
  else
    _cmake_opts+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  msg2 "Building static library"
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      "${_cmake_opts[@]}" \
      -DBUILD_SHARED_LIBS=OFF \
      -B "build-${MSYSTEM}-static"

  cmake --build "build-${MSYSTEM}-static"

  msg2 "Building shared library"
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      "${_cmake_opts[@]}" \
      -DBUILD_SHARED_LIBS=ON \
      -B "build-${MSYSTEM}-shared"

  cmake --build "build-${MSYSTEM}-shared"
}

check() {
  ${srcdir}/build-${MSYSTEM}-static/kcp_test.exe
}

package() {
  DESTDIR="${pkgdir}" cmake --install build-${MSYSTEM}-static
  mv "${pkgdir}${MINGW_PREFIX}/lib/cmake/${_realname}" "${pkgdir}${MINGW_PREFIX}/lib/cmake/${_realname}-static"
  DESTDIR="${pkgdir}" cmake --install build-${MSYSTEM}-shared
  mv "${pkgdir}${MINGW_PREFIX}/lib/cmake/${_realname}" "${pkgdir}${MINGW_PREFIX}/lib/cmake/${_realname}-shared"

  install -Dm644 "${srcdir}/${_realname}-${pkgver}/LICENSE" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
  install -Dm644 "${srcdir}/${_realname}-${pkgver}/README.md" \
    "${pkgdir}${MINGW_PREFIX}/share/doc/${_realname}/README.md"
}
